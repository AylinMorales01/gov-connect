root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.{java,xml,yml,yaml}]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,json,css}]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
