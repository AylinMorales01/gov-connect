# =============================================================================
# Gov Connect — Variables de Entorno
# =============================================================================
# Instrucciones:
#   1. Copia este archivo como .env en la raíz del proyecto:
#      cp .env.example .env
#   2. Completa los valores con tus credenciales reales.
#   3. NUNCA subas el archivo .env al repositorio (ya está en .gitignore).
# =============================================================================

# ---------------------------------------------------------------------------
# Backend — Spring Boot (application.yaml)
# ---------------------------------------------------------------------------
# Puerto del servidor (default: 8080)
SERVER_PORT=8080

# SQL Server — Base de datos operacional
GOVCONNECT_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=GOV_CONNECT_DB;encrypt=true;trustServerCertificate=true
GOVCONNECT_DB_USERNAME=sa
GOVCONNECT_DB_PASSWORD=TU_PASSWORD_SEGURA_AQUI

# ---------------------------------------------------------------------------
# Frontend — React (VITE_* variables)
# ---------------------------------------------------------------------------
# URL base de la API del backend
VITE_API_URL=http://localhost:8080/api/v1
