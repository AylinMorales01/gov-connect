# =============================================================================
# Gov Connect — Variables de Entorno
# =============================================================================
# Instrucciones:
#   1. Copia este archivo como .env en la raíz del proyecto:
#      cp .env.example .env
#   2. Completa los valores con tus credenciales reales.
#   3. NUNCA subas el archivo .env al repositorio (ya está en .gitignore).
# =============================================================================

# ---------------------------------------------------------------------------
# Docker Compose (opción recomendada para levantar todo el entorno)
# ---------------------------------------------------------------------------
# Estas variables las usa `docker compose` (docker-compose.yml) para el
# contenedor de SQL Server y el inicializador de la base de datos.

# Contraseña de `sa` para el contenedor SQL Server. Elige una propia: este
# archivo se versiona, así que aquí nunca va un valor real.
# ⚠️ SQL Server exige una contraseña FUERTE: mínimo 8 caracteres y combinar
#    3 de estas 4 categorías: mayúsculas, minúsculas, números y símbolos.
#    Si la contraseña no cumple la política, el contenedor `db` no arranca.
MSSQL_SA_PASSWORD=TU_PASSWORD_FUERTE_AQUI

# ¿Cargar datos demo (database/seed/) en el primer arranque?
#   true  → dashboards con datos y login admin/password listos.
#   false → solo esquema + usuarios de prueba, sin datos demo.
SEED_DEMO=true

# Puerto del host para el frontend en modo prod-like (nginx). Default: 80.
FRONTEND_PORT=80

# Puerto del host para el frontend en modo desarrollo (Vite). Default: 5173.
FRONTEND_DEV_PORT=5173

# Nota sobre GOVCONNECT_DB_URL: dentro de Docker el backend se conecta al
# servicio `db`, por lo que docker-compose.yml FIJA la URL internamente
# (jdbc:sqlserver://db:1433;...). El valor de GOVCONNECT_DB_URL de abajo solo
# se usa cuando levantas el backend FUERA de Docker (mvnw spring-boot:run).

# ---------------------------------------------------------------------------
# Backend — Spring Boot (application.yaml)
# ---------------------------------------------------------------------------
# Perfil de Spring Boot (dev, prod, o vacío para defaults)
#   dev  → SQL visible, Swagger habilitado, logging DEBUG
#   prod → SQL oculto, Swagger deshabilitado, logging INFO
# ⚠️ Para desarrollo LOCAL usa `dev`. El perfil `prod` activa cookie-secure=true,
#    que sobre HTTP (http://localhost) hace que el navegador descarte la cookie
#    de sesión y el login falle.
SPRING_PROFILES_ACTIVE=dev

# Puerto del servidor (default: 8080)
# En PaaS (Render, Heroku…) la plataforma inyecta PORT, que tiene prioridad
# sobre SERVER_PORT; no hace falta definir ninguna de las dos allí.
SERVER_PORT=8080

# CORS — Orígenes autorizados del frontend, separados por coma.
# No se admite "*": la autenticación usa cookies (allowCredentials=true).
# Incluye los puertos de desarrollo (5173) y del frontend compilado (80).
#   Producción: CORS_ALLOWED_ORIGINS=https://tu-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173

# SQL Server — Base de datos operacional
# ─── Desarrollo (SIN Docker) ─────────────────────────────────
# trustServerCertificate=true acepta certificados autofirmados (localhost).
# NUNCA usar en producción — deshabilita la validación TLS.
GOVCONNECT_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=GOV_CONNECT_DB;encrypt=true;trustServerCertificate=true
# ─── Producción ───────────────────────────────────────────
# Requiere un certificado TLS válido en el servidor SQL Server.
# GOVCONNECT_DB_URL=jdbc:sqlserver://TU_SERVIDOR:1433;databaseName=GOV_CONNECT_DB;encrypt=true;trustServerCertificate=false
GOVCONNECT_DB_USERNAME=sa
GOVCONNECT_DB_PASSWORD=TU_PASSWORD_SEGURA_AQUI

# JWT — Autenticación (OBLIGATORIO)
# La aplicación NO iniciará si JWT_SECRET no está definido.
# Debe tener al menos 256 bits (32 caracteres) para HMAC-SHA256.
# Generar una clave segura:
#   openssl rand -base64 32
#   o en Linux: tr -dc 'A-Za-z0-9!@#$%^&*()_+-=' < /dev/urandom | head -c 64
JWT_SECRET=REEMPLAZAR_POR_UNA_CLAVE_SEGURA_DE_AL_MENOS_32_CARACTERES
# Duración del access token en segundos (3600 = 1 hora, 900 = 15 min recomendado para prod)
JWT_EXPIRATION=3600
# Duración del refresh token en segundos (604800 = 7 días, default si no se especifica)
JWT_REFRESH_EXPIRATION=604800

# Swagger UI — Documentación interactiva de la API
# Habilitar solo en desarrollo. Deshabilitar en producción: SWAGGER_ENABLED=false
SWAGGER_ENABLED=true

# DuckDB — Base de datos analítica embebida
# Ruta relativa al CWD del proceso (raíz del repositorio, o /app en Docker).
# En producción puede apuntar a una ruta absoluta o a un volumen persistente.
DUCKDB_PATH=database/analytics/analytics.duckdb

# ETL — Directorio de archivos CSV temporales
# Relativo al CWD del proceso.
ETL_EXPORT_DIR=exports

# ---------------------------------------------------------------------------
# SMTP — Alerta de contratos por vencer (opcional)
# ---------------------------------------------------------------------------
# host vacío => SMTP deshabilitado: la alerta registra el fallo en
# automation_logs sin detener la aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# ---------------------------------------------------------------------------
# Alerta programada de contratos por vencer (opcional)
# ---------------------------------------------------------------------------
ALERT_EXPIRING_ENABLED=true
ALERT_EXPIRING_RECIPIENTS=
ALERT_EXPIRING_DAYS=30
ALERT_EXPIRING_FROM=no-reply@govconnect.com
ALERT_EXPIRING_CRON=0 0 7 * * MON-FRI

# ---------------------------------------------------------------------------
# Frontend — React (VITE_* variables)
# ---------------------------------------------------------------------------
# URL base de la API del backend. La resuelve el NAVEGADOR (no Docker), por eso
# apunta a localhost y no al nombre de servicio `backend`.
# En producción apunta al dominio del backend desplegado.
VITE_API_URL=http://localhost:8080/api/v1
